# LINE channel credentials (required)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Optional overrides
LINE_API_BASE=https://api.line.me
PORT=8080
LINE_PUBLIC_ANALYSIS_BASE_URL=https://your-public-frontend.example.com/analyses
LINE_PLATFORM_ENABLED=true
LINE_PLATFORM_BASE_URL=http://localhost:8081
LINE_PLATFORM_STOCK_SIGNAL_PATH=/api/stock-signals/generate

# Push master toggle. Keep test-only true until production rollout is intended.
LINE_PUSH_ENABLED=true
LINE_PUSH_TEST_ONLY=true
LINE_PUSH_RATE_LIMIT_ENABLED=false
LINE_PUSH_PUBLIC_ANALYSIS_DAILY_MAX_PER_TARGET=2
LINE_PUSH_STOCK_QUERY_DAILY_MAX_PER_TARGET=3
LINE_PUSH_RATE_LIMIT_ZONE=Asia/Taipei
LINE_PUSH_RATE_LIMIT_KEY_PREFIX=line:push:rate-limit
LINE_STOCK_SIGNAL_CACHE_ENABLED=true
LINE_STOCK_SIGNAL_CACHE_KEY_PREFIX=line:stock-signal:cache
LINE_STOCK_SIGNAL_CACHE_TTL=6h
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_TIMEOUT=3000ms

# MySQL (shared with Python news-collector). Default OFF; when false, the
# MarketAnalysisPoller, repositories, and /admin endpoints are not registered.
LINE_RELAY_MYSQL_ENABLED=false
LINE_RELAY_MYSQL_URL=jdbc:mysql://localhost:3306/news_relay?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
LINE_RELAY_MYSQL_USER=
LINE_RELAY_MYSQL_PASSWORD=
LINE_RELAY_MYSQL_CONNECT_TIMEOUT_MS=5000

# Table names (override only if your schema uses different names)
LINE_RELAY_MYSQL_ANALYSIS_TABLE=t_market_analyses
LINE_RELAY_MYSQL_GROUP_TABLE=t_bot_group_info
LINE_RELAY_MYSQL_USER_TABLE=t_bot_user_info
LINE_RELAY_MYSQL_TRADE_SIGNAL_TABLE=t_trade_signals

# Scheduled pushes. Cron values are interpreted in LINE_SCHEDULE_ZONE.
LINE_SCHEDULE_ENABLED=true
LINE_SCHEDULE_ZONE=Asia/Taipei
LINE_SCHEDULE_US_CLOSE_CRON=0 30 5 * * SAT
LINE_SCHEDULE_PRE_TW_OPEN_CRON=0 50 7 * * *
LINE_SCHEDULE_WEEKLY_TW_PREOPEN_CRON=0 10 5 * * SUN
LINE_SCHEDULE_DISABLE_STALE_UNPUSHED_CRON=0 0 0 * * *
# Comma-separated market holidays used by the public-analysis routing matrix.
# TW closed + US open => us_close; US closed + TW open => pre_tw_open; both closed => macro_daily.
LINE_SCHEDULE_TW_MARKET_HOLIDAYS=
LINE_SCHEDULE_US_MARKET_HOLIDAYS=
